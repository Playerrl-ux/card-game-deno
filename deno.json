{
  "compilerOptions": {
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strict": false,
    "strictFunctionTypes": true
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run -A --sloppy-imports src/network/websocket.controller.ts",
    "dev": "deno run -A --watch=src/ --sloppy-imports src/network/websocket.controller.ts",
    "test": "deno run -A --sloppy-imports npm:vitest run",
    "test:watch": "deno run -A --sloppy-imports npm:vitest",
    "test:debug": "deno run -A --sloppy-imports npm:vitest run --reporter=verbose",
    "export:rooms": "deno run -A scripts/export-room-events.ts"
  },
  "imports": {
    "hono": "npm:hono@^4.12.23",
    "zod": "npm:zod@^4.4.3",
    "vitest": "npm:vitest@^4.1.10"
  },
  "watcher": {
    "exclude": ["data/"]
  }
}
